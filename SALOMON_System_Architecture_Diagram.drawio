        </mxCell>
        <mxCell id="3" value="&lt;div style=&quot;font-family:Inter, Noto Sans JP, sans-serif;&quot;&gt;&#10;      &lt;span style=&quot;background-color:#000000; color:#FFFFFF; font-size:16px; font-weight:800; padding:4px 10px; border-radius:4px; margin-right:12px;&quot;&gt;SALOMON&lt;/span&gt;&#10;      &lt;span style=&quot;font-size:22px; font-weight:800; color:#0F172A;&quot;&gt;AI マウンテンコンシェルジュ — システム構成図&lt;/span&gt;&#10;      &lt;span style=&quot;font-size:12px; font-weight:600; color:#475569; background-color:#F1F5F9; padding:4px 8px; border-radius:4px; margin-left:10px;&quot;&gt;System Architecture (Xserver VPS)&lt;/span&gt;&#10;      &lt;br&gt;&lt;span style=&quot;font-size:12px; color:#64748b; font-weight:500;&quot;&gt;店頭サイネージ端末（110インチ）・Xserver VPS 基盤（国内データセンター）・OpenAI リアルタイム音声対話連携設計&lt;/span&gt;&#10;    &lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="50" width="800" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;div style=&quot;text-align:right; font-family:Inter, Noto Sans JP, sans-serif; font-size:11px; font-weight:700;&quot;&gt;&#10;      &lt;span style=&quot;background:#EFF6FF; color:#1E40AF; border:1px solid #BFDBFE; padding:6px 10px; border-radius:6px; margin-right:6px;&quot;&gt;📍 Xserver VPS 国内DC (10Gbps NVMe)&lt;/span&gt;&#10;      &lt;span style=&quot;background:#ECFDF5; color:#065F46; border:1px solid #A7F3D0; padding:6px 10px; border-radius:6px; margin-right:6px;&quot;&gt;🔒 PII 保持ゼロ / TLS 1.3&lt;/span&gt;&#10;      &lt;span style=&quot;background:#FEF3C7; color:#92400E; border:1px solid #FDE68A; padding:6px 10px; border-radius:6px;&quot;&gt;🖥️ 110インチ 大型サイネージ仕様&lt;/span&gt;&#10;    &lt;/div&gt;" style="text;html=1;align=right;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
