        <mxCell id="7" value="&lt;b&gt;3. 外部連携サービス (EXTERNAL APIS)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#047857;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1320" y="130" width="300" height="25" as="geometry" />
        </mxCell>
        <mxCell id="8" value="&lt;div style=&quot;font-family:Noto Sans JP, sans-serif; text-align:left; padding:4px;&quot;&gt;&#10;      &lt;div style=&quot;color:#0284C7; font-size:11px; font-weight:700;&quot;&gt;In-Store Kiosk Display&lt;/div&gt;&#10;      &lt;div style=&quot;color:#0F172A; font-size:15px; font-weight:800; margin-top:2px;&quot;&gt;店頭サイネージ端末&lt;/div&gt;&#10;      &lt;div style=&quot;margin-top:6px; font-size:11px; color:#475569; line-height:1.5;&quot;&gt;&#10;        ・サロモン高尾店 設置端末&lt;br&gt;&#10;        ・&lt;b&gt;110インチ 大型高精細ディスプレイ&lt;/b&gt;&lt;br&gt;&#10;        ・タッチパネル &amp; マイク音声入力&lt;br&gt;&#10;        ・&lt;b&gt;完全匿名利用（会員登録・ログイン不要）&lt;/b&gt;&lt;br&gt;&#10;        ・個人情報(PII)保持ゼロ&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;margin-top:8px; display:inline-block; background:#E0F2FE; color:#0369A1; font-size:10px; font-weight:700; padding:3px 8px; border-radius:4px;&quot;&gt;&#10;        HTTPS / WSS (TLS 1.3)&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38BDF8;strokeWidth=2;align=left;verticalAlign=top;arcSize=6;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="170" width="270" height="220" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;div style=&quot;font-family:Noto Sans JP, sans-serif; text-align:left; padding:4px;&quot;&gt;&#10;      &lt;div style=&quot;color:#6366F1; font-size:11px; font-weight:700;&quot;&gt;Admin / Editor Console&lt;/div&gt;&#10;      &lt;div style=&quot;color:#0F172A; font-size:15px; font-weight:800; margin-top:2px;&quot;&gt;店舗スタッフ / 管理端末&lt;/div&gt;&#10;      &lt;div style=&quot;margin-top:6px; font-size:11px; color:#475569; line-height:1.5;&quot;&gt;&#10;        ・おすすめコールアウト編集&lt;br&gt;&#10;        ・店舗お知らせ・注意報更新&lt;br&gt;&#10;        ・&lt;b&gt;PIN認証 &amp; 接続元IP制限&lt;/b&gt;&lt;br&gt;&#10;        ・MFA（多要素認証）適用&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;margin-top:8px; display:inline-block; background:#EEF2FF; color:#4338CA; font-size:10px; font-weight:700; padding:3px 8px; border-radius:4px;&quot;&gt;&#10;        管理権限分離 / 暗号化&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#818CF8;strokeWidth=2;align=left;verticalAlign=top;arcSize=6;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="420" width="270" height="190" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;div style=&quot;font-family:Noto Sans JP, sans-serif; text-align:left; padding:4px;&quot;&gt;&#10;      &lt;div style=&quot;color:#10B981; font-size:11px; font-weight:700;&quot;&gt;Mobile / QR Access&lt;/div&gt;&#10;      &lt;div style=&quot;color:#0F172A; font-size:15px; font-weight:800; margin-top:2px;&quot;&gt;来訪者モバイル端末&lt;/div&gt;&#10;      &lt;div style=&quot;margin-top:6px; font-size:11px; color:#475569; line-height:1.5;&quot;&gt;&#10;        ・110インチ画面のQRコード読取&lt;br&gt;&#10;        ・コースマップ・標高情報の携帯閲覧&lt;br&gt;&#10;        ・&lt;b&gt;個人情報入力画面なし&lt;/b&gt;&lt;br&gt;&#10;        ・完全リードオンリー配信&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;margin-top:8px; display:inline-block; background:#ECFDF5; color:#047857; font-size:10px; font-weight:700; padding:3px 8px; border-radius:4px;&quot;&gt;&#10;        Nginx エッジ直接配信&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34D399;strokeWidth=2;align=left;verticalAlign=top;arcSize=6;shadow=1;" parent="1" vertex="1">
          <mxGeometry x="60" y="640" width="270" height="190" as="geometry" />
        </mxCell>
        <mxCell id="11" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2.5;dashed=1;arcSize=4;" parent="1" vertex="1">
          <mxGeometry x="370" y="160" width="910" height="680" as="geometry" />
