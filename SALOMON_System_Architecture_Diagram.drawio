        <mxCell id="40" value="&lt;div style=&quot;font-family:Noto Sans JP, sans-serif; font-size:11.5px; color:#334155; line-height:1.5;&quot;&gt;&#10;      &lt;b&gt;エンドツーエンド・データフロー概要 (質問C1/D12対応)&lt;/b&gt;: &amp;nbsp;&#10;      &lt;b&gt;① 起動・静的配信&lt;/b&gt;: 110インチ端末起動 → Xserver VPS (Nginx) から Next.js UI &amp; 3Dアセットを高速キャッシュ配信 (TLS 1.3) &amp;nbsp;|&amp;nbsp;&#10;      &lt;b&gt;② 音声対話&lt;/b&gt;: 利用者発話 → Nginx (WSS中継) → Next.js (エフェメラルセッション) → OpenAI API 音声解析・回答生成 &amp;nbsp;|&amp;nbsp;&#10;      &lt;b&gt;③ 保存ゼロ原則&lt;/b&gt;: 音声ストリームはメモリ上でのみ処理され、ディスク・ログへの保存なし（完全即時破棄）&#10;    &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;align=left;verticalAlign=middle;arcSize=4;" parent="1" vertex="1">
          <mxGeometry x="60" y="860" width="1550" height="45" as="geometry" />
        </mxCell>
        <mxCell id="41" value="&lt;b&gt;🔒 PII 保持ゼロ（完全匿名）&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px; color:#64748b;'&gt;氏名・住所・決済・生体情報は一切取得・保持しません。マイク音声はメモリ処理後即時破棄。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;align=left;verticalAlign=top;arcSize=4;" parent="1" vertex="1">
          <mxGeometry x="60" y="920" width="365" height="65" as="geometry" />
        </mxCell>
        <mxCell id="42" value="&lt;b&gt;🛡️ 全域暗号化 (In-Transit &amp; At-Rest)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px; color:#64748b;'&gt;通信は TLS 1.3 強制、シークレットは root 権限 600 で保護。OpenAI API キーは外部へ一切露出なし。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;align=left;verticalAlign=top;arcSize=4;" parent="1" vertex="1">
          <mxGeometry x="455" y="920" width="365" height="65" as="geometry" />
        </mxCell>
        <mxCell id="43" value="&lt;b&gt;⚡ UFW + Fail2ban 二重防護&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px; color:#64748b;'&gt;不要ポート完全閉鎖、SSHは鍵認証&amp;IP制限。不正レート・攻撃アクセスは即時自動IP BAN。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;align=left;verticalAlign=top;arcSize=4;" parent="1" vertex="1">
          <mxGeometry x="850" y="920" width="365" height="65" as="geometry" />
        </mxCell>
        <mxCell id="44" value="&lt;b&gt;🏢 国内専用 VPS &amp; 国際認証基盤&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px; color:#64748b;'&gt;他社DB相乗りなしの専用VPS。OpenAI API は SOC 2 Type II 準拠 &amp; Zero Data Retention 保証。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;align=left;verticalAlign=top;arcSize=4;" parent="1" vertex="1">
          <mxGeometry x="1245" y="920" width="365" height="65" as="geometry" />
        </mxCell>
      </root>
