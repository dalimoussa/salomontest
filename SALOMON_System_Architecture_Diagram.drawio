        <mxCell id="12" value="&lt;b&gt;🖥️ Xserver VPS (Linux / Ubuntu 24.04 LTS) — 国内データセンター (10Gbps 高速NVMe)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563EB;fontColor=#FFFFFF;fontSize=11;fontStyle=1;strokeColor=none;align=center;" parent="1" vertex="1">
          <mxGeometry x="390" y="148" width="560" height="24" as="geometry" />
