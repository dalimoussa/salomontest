        <mxCell id="39" value="APIキー安全注入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;dashed=1;fontColor=#D97706;fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;labelBorderColor=#D97706;" parent="1" edge="1" source="25" target="24">
